<?xml version="1.0" encoding="utf-8"?>
<!--
  门禁 MAC / Key 属于敏感凭据：不进入云备份，也不参与换机迁移。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="data.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="data.xml" />
    </device-transfer>
</data-extraction-rules>
